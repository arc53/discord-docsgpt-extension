# Single-bot setup without a config file (same variables as v1).
DISCORD_TOKEN=your-bot-token
API_KEY=your-docsgpt-agent-api-key
# API_KEY_SALES=another-agent-key        # more agents: "#sales question" or /agent
# API_BASE=https://gptcloud.arc53.com    # self-hosted DocsGPT URL

# Storage: sqlite (default) or memory. MongoDB was removed in version 2.
# SQLITE_PATH=data/docsgpt-discord.db
# STORAGE_TYPE=memory

# Behaviour
# THREADS=true            # in servers, answer a mention in a new thread
# FOLLOW_THREADS=true     # answer every message in the bot's threads (needs the Message Content intent)
# STREAMING=true
# FILES=true
# MAX_FILE_MB=20
# SLASH_COMMANDS=true     # register /ask, /agents, /agent, /new
# ALLOWED_GUILDS=123456789012345678,234567890123456789

# Logging
# RUST_LOG=info
# LOG_FORMAT=json
